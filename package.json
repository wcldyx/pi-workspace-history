{
  "name": "pi-workspace-history",
  "version": "0.5.0",
  "type": "module",
  "description": "Undo, roll back, and revert code changes made by the Pi coding agent: files and conversation together. One-step /undo and /redo, /tree workspace restore, /diff, and manual checkpoints, with history kept outside your repository.",
  "author": "wcldyx",
  "keywords": [
    "pi-package",
    "pi",
    "pi-plugin",
    "pi-extension",
    "pi-agent",
    "pi-coding-agent",
    "workspace-history",
    "undo",
    "redo",
    "rewind",
    "rollback",
    "revert",
    "restore",
    "checkpoint",
    "snapshot",
    "git-snapshot",
    "file-history",
    "time-machine",
    "jujutsu"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wcldyx/pi-workspace-history.git"
  },
  "homepage": "https://github.com/wcldyx/pi-workspace-history#readme",
  "bugs": {
    "url": "https://github.com/wcldyx/pi-workspace-history/issues"
  },
  "files": [
    ".pi/extensions/workspace-history.ts",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "llms.txt"
  ],
  "pi": {
    "extensions": [
      ".pi/extensions/workspace-history.ts"
    ],
    "image": "https://raw.githubusercontent.com/wcldyx/pi-workspace-history/main/demo.gif"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/workspace-history.test.ts",
    "bench:first-turn": "tsx tests/benchmark-first-turn.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "ignore": "^7.0.5"
  }
}
